# =============================================================================
# AI Trade — Secrets file (copy to `.env` and fill in real values)
# =============================================================================
# This file is version-controlled as a TEMPLATE only. The real `.env` sits
# next to it and is git-ignored. Keys read here are injected into the config
# object at startup — never put secrets in settings.yaml.
# =============================================================================

# --- Alpaca API credentials -------------------------------------------------
# Generate at https://app.alpaca.markets (Paper) or https://alpaca.markets (Live)
# Paper and Live keys are DIFFERENT — make sure ALPACA_PAPER matches the key set.
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_PAPER=true

# --- Email alerts (optional) ------------------------------------------------
# Uses Gmail SMTP with an App Password (regular Gmail password will NOT work).
# Generate one at: Google Account > Security > 2-Step Verification > App passwords
# Leave blank to disable email alerts entirely.
# SMTP host/port are hardcoded to smtp.gmail.com:587 — change in monitoring/notifier.py
# if using a different provider.
SMTP_USER=
SMTP_PASS=
